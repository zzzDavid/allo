diff --git a/golang/uPIMulator/src/assembler/prim/atim_va.go b/golang/uPIMulator/src/assembler/prim/atim_va.go
new file mode 100644
index 0000000000000000000000000000000000000000..5fcd8633737d19e048fbfd3d72e5ffb24a5b7726
--- /dev/null
+++ b/golang/uPIMulator/src/assembler/prim/atim_va.go
@@ -0,0 +1,164 @@
+package prim
+
+import (
+	"fmt"
+	"uPIMulator/src/abi/encoding"
+	"uPIMulator/src/abi/word"
+	"uPIMulator/src/misc"
+)
+
+const atimVaNumElements = 256
+
+// atimVaSmokeInput is the exact first 256-int32 input used by the archived
+// ATiM SDK-2021.3 smoke. ATiM's cached host_array call supplied this same
+// array for both A and B.
+var atimVaSmokeInput = [...]int64{
+	24, 40, 27, 46, 43, 48, 42, 20,
+	29, 25, 40, 46, 16, 42, 16, 47,
+	37, 15, 6, 21, 7, 28, 22, 34,
+	24, 19, 27, 0, 28, 9, 42, 19,
+	38, 2, 25, 28, 6, 0, 6, 23,
+	36, 12, 9, 16, 31, 49, 35, 26,
+	21, 24, 11, 48, 40, 0, 14, 46,
+	20, 0, 34, 41, 9, 30, 15, 7,
+	27, 10, 36, 10, 11, 30, 7, 42,
+	10, 3, 34, 37, 15, 45, 1, 13,
+	32, 22, 47, 45, 0, 29, 30, 47,
+	45, 14, 49, 26, 45, 13, 20, 40,
+	1, 23, 38, 45, 5, 15, 46, 48,
+	46, 43, 41, 47, 22, 45, 44, 42,
+	30, 1, 0, 13, 37, 47, 9, 30,
+	45, 23, 18, 8, 25, 41, 26, 4,
+	48, 41, 44, 33, 16, 21, 27, 37,
+	43, 38, 2, 29, 43, 16, 9, 22,
+	41, 25, 5, 37, 48, 9, 9, 4,
+	43, 44, 0, 23, 39, 43, 27, 39,
+	46, 22, 32, 24, 16, 3, 28, 29,
+	22, 2, 32, 35, 29, 23, 15, 22,
+	24, 22, 21, 18, 32, 2, 13, 14,
+	29, 18, 34, 46, 43, 30, 12, 29,
+	19, 12, 10, 7, 0, 0, 31, 23,
+	3, 14, 34, 31, 25, 24, 15, 33,
+	47, 8, 12, 29, 24, 5, 37, 41,
+	17, 42, 7, 47, 15, 10, 25, 9,
+	17, 27, 8, 31, 13, 13, 17, 19,
+	25, 24, 35, 13, 8, 16, 39, 40,
+	34, 49, 27, 8, 33, 33, 38, 12,
+	10, 20, 38, 29, 30, 46, 11, 8,
+}
+
+// AtimVa supplies uPIMulator's host fixtures for the exact archived ATiM VA
+// kernel. The kernel has fixed 256-element A/B/C symbols and was generated for
+// one block/DPU and one tasklet.
+type AtimVa struct {
+	numDpus       int
+	numTasklets   int
+	numExecutions int
+
+	bufferA []int64
+	bufferB []int64
+	bufferC []int64
+}
+
+func (this *AtimVa) Init(commandLineParser *misc.CommandLineParser) {
+	numChannels := int(commandLineParser.IntParameter("num_channels"))
+	numRanksPerChannel := int(commandLineParser.IntParameter("num_ranks_per_channel"))
+	numDpusPerRank := int(commandLineParser.IntParameter("num_dpus_per_rank"))
+
+	this.numDpus = numChannels * numRanksPerChannel * numDpusPerRank
+	this.numTasklets = int(commandLineParser.IntParameter("num_tasklets"))
+	this.numExecutions = 1
+
+	if this.numDpus != 1 {
+		panic(fmt.Errorf("ATIM-VA requires exactly one DPU, got %d", this.numDpus))
+	}
+	if this.numTasklets != 1 {
+		panic(fmt.Errorf("ATIM-VA was generated for exactly one tasklet, got %d", this.numTasklets))
+	}
+
+	dataPrepParams := commandLineParser.DataPrepParams()
+	if len(dataPrepParams) != 1 || dataPrepParams[0] != atimVaNumElements {
+		panic(fmt.Errorf("ATIM-VA requires exactly %d int32 elements", atimVaNumElements))
+	}
+
+	this.initSmokeBuffers()
+}
+
+func (this *AtimVa) initSmokeBuffers() {
+	this.bufferA = make([]int64, atimVaNumElements)
+	this.bufferB = make([]int64, atimVaNumElements)
+	this.bufferC = make([]int64, atimVaNumElements)
+	for i, value := range atimVaSmokeInput {
+		this.bufferA[i] = value
+		this.bufferB[i] = value
+		this.bufferC[i] = value + value
+	}
+}
+
+func appendAtimUint32(byteStream *encoding.ByteStream, value int64) {
+	valueWord := new(word.Word)
+	valueWord.Init(32)
+	valueWord.SetValue(value)
+	byteStream.Merge(valueWord.ToByteStream())
+}
+
+func atimInt32ByteStream(values []int64) *encoding.ByteStream {
+	byteStream := new(encoding.ByteStream)
+	byteStream.Init()
+	for _, value := range values {
+		appendAtimUint32(byteStream, value)
+	}
+	return byteStream
+}
+
+func emptyAtimByteStream() *encoding.ByteStream {
+	byteStream := new(encoding.ByteStream)
+	byteStream.Init()
+	return byteStream
+}
+
+func (this *AtimVa) InputDpuHost(execution int, dpuId int) map[string]*encoding.ByteStream {
+	this.validateIndices(execution, dpuId)
+
+	blockIdx := new(encoding.ByteStream)
+	blockIdx.Init()
+	appendAtimUint32(blockIdx, 0)
+	appendAtimUint32(blockIdx, 0)
+	appendAtimUint32(blockIdx, 0)
+
+	return map[string]*encoding.ByteStream{
+		"A":        atimInt32ByteStream(this.bufferA),
+		"B":        atimInt32ByteStream(this.bufferB),
+		"blockIdx": blockIdx,
+	}
+}
+
+func (this *AtimVa) OutputDpuHost(execution int, dpuId int) map[string]*encoding.ByteStream {
+	this.validateIndices(execution, dpuId)
+	return map[string]*encoding.ByteStream{
+		"C": atimInt32ByteStream(this.bufferC),
+	}
+}
+
+func (this *AtimVa) InputDpuMramHeapPointerName(execution int, dpuId int) (int64, *encoding.ByteStream) {
+	this.validateIndices(execution, dpuId)
+	return 0, emptyAtimByteStream()
+}
+
+func (this *AtimVa) OutputDpuMramHeapPointerName(execution int, dpuId int) (int64, *encoding.ByteStream) {
+	this.validateIndices(execution, dpuId)
+	return 0, emptyAtimByteStream()
+}
+
+func (this *AtimVa) NumExecutions() int {
+	return this.numExecutions
+}
+
+func (this *AtimVa) validateIndices(execution int, dpuId int) {
+	if execution < 0 || execution >= this.numExecutions {
+		panic(fmt.Errorf("execution %d is outside [0, %d)", execution, this.numExecutions))
+	}
+	if dpuId < 0 || dpuId >= this.numDpus {
+		panic(fmt.Errorf("DPU ID %d is outside [0, %d)", dpuId, this.numDpus))
+	}
+}
diff --git a/golang/uPIMulator/src/assembler/prim/atim_va_test.go b/golang/uPIMulator/src/assembler/prim/atim_va_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a8fe485c84146faaee364125e41ec2dba47cae62
--- /dev/null
+++ b/golang/uPIMulator/src/assembler/prim/atim_va_test.go
@@ -0,0 +1,57 @@
+package prim
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"testing"
+)
+
+func TestAtimVaArchivedSmokeFixtures(t *testing.T) {
+	fixture := &AtimVa{
+		numDpus:       1,
+		numTasklets:   1,
+		numExecutions: 1,
+	}
+	fixture.initSmokeBuffers()
+
+	input := fixture.InputDpuHost(0, 0)
+	if got := input["A"].Size(); got != 4*atimVaNumElements {
+		t.Fatalf("A fixture size = %d, want %d", got, 4*atimVaNumElements)
+	}
+	if got := input["B"].Size(); got != 4*atimVaNumElements {
+		t.Fatalf("B fixture size = %d, want %d", got, 4*atimVaNumElements)
+	}
+	if got := input["blockIdx"].Size(); got != 12 {
+		t.Fatalf("blockIdx fixture size = %d, want 12", got)
+	}
+
+	aBytes := make([]byte, input["A"].Size())
+	for i := range aBytes {
+		aBytes[i] = input["A"].Get(i)
+		if input["B"].Get(i) != aBytes[i] {
+			t.Fatalf("B differs from archived cached A at byte %d", i)
+		}
+	}
+	if got := fmt.Sprintf("%x", sha256.Sum256(aBytes)); got != "7469686dc29010ff5bad4017c005492b75e4dc4e794675cc42ae2b30ebf226ef" {
+		t.Fatalf("archived input SHA-256 = %s", got)
+	}
+
+	output := fixture.OutputDpuHost(0, 0)["C"]
+	if got := output.Size(); got != 4*atimVaNumElements {
+		t.Fatalf("C oracle size = %d, want %d", got, 4*atimVaNumElements)
+	}
+	for i, inputValue := range atimVaSmokeInput {
+		offset := 4 * i
+		actual := int32(binary.LittleEndian.Uint32([]byte{
+			output.Get(offset),
+			output.Get(offset + 1),
+			output.Get(offset + 2),
+			output.Get(offset + 3),
+		}))
+		expected := int32(inputValue + inputValue)
+		if actual != expected {
+			t.Fatalf("C[%d] = %d, want %d", i, actual, expected)
+		}
+	}
+}
diff --git a/golang/uPIMulator/src/assembler/prim/generic.go b/golang/uPIMulator/src/assembler/prim/generic.go
new file mode 100644
index 0000000000000000000000000000000000000000..904455f14dac159c592bd079f91c207974d3c84d
--- /dev/null
+++ b/golang/uPIMulator/src/assembler/prim/generic.go
@@ -0,0 +1,404 @@
+package prim
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"uPIMulator/src/abi/encoding"
+	"uPIMulator/src/misc"
+)
+
+const genericManifestVersion = 1
+
+var genericHostSymbolPattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+// genericManifest is the on-disk description for a GENERIC benchmark. Raw
+// binary paths are relative to the fixture directory containing manifest.json.
+type genericManifest struct {
+	SchemaVersion int                `json:"schema_version"`
+	NumDpus       int                `json:"num_dpus"`
+	NumTasklets   int                `json:"num_tasklets"`
+	Executions    []genericExecution `json:"executions"`
+}
+
+type genericExecution struct {
+	Dpus []genericDpuManifest `json:"dpus"`
+}
+
+type genericDpuManifest struct {
+	HostInputs     map[string]string    `json:"host_inputs"`
+	HostOutputs    map[string]string    `json:"host_outputs"`
+	MramHeapInput  *genericMramManifest `json:"mram_heap_input"`
+	MramHeapOutput *genericMramManifest `json:"mram_heap_output"`
+}
+
+type genericMramManifest struct {
+	Offset int64  `json:"offset"`
+	File   string `json:"file"`
+}
+
+type genericDpuFixture struct {
+	hostInputs     map[string]*encoding.ByteStream
+	hostOutputs    map[string]*encoding.ByteStream
+	mramHeapInput  genericMramFixture
+	mramHeapOutput genericMramFixture
+}
+
+type genericMramFixture struct {
+	offset int64
+	bytes  *encoding.ByteStream
+}
+
+// Generic supplies uPIMulator host fixtures from a versioned JSON manifest.
+// It lets externally generated DPU programs retain their native __host symbol
+// names and DPU_MRAM_HEAP_POINTER_NAME layouts without adding a Go adapter for
+// each benchmark.
+type Generic struct {
+	numDpus     int
+	numTasklets int
+	executions  [][]genericDpuFixture
+}
+
+func (this *Generic) Init(commandLineParser *misc.CommandLineParser) {
+	numChannels := int(commandLineParser.IntParameter("num_channels"))
+	numRanksPerChannel := int(commandLineParser.IntParameter("num_ranks_per_channel"))
+	numDpusPerRank := int(commandLineParser.IntParameter("num_dpus_per_rank"))
+	expectedNumDpus := numChannels * numRanksPerChannel * numDpusPerRank
+	expectedNumTasklets := int(commandLineParser.IntParameter("num_tasklets"))
+
+	loaded, err := loadGenericFixture(
+		commandLineParser.StringParameter("fixture_dir"),
+		expectedNumDpus,
+		expectedNumTasklets,
+	)
+	if err != nil {
+		panic(err)
+	}
+	*this = *loaded
+}
+
+func loadGenericFixture(
+	fixtureDir string,
+	expectedNumDpus int,
+	expectedNumTasklets int,
+) (*Generic, error) {
+	if strings.TrimSpace(fixtureDir) == "" {
+		return nil, errors.New("GENERIC requires a non-empty --fixture_dir")
+	}
+
+	manifestPath := filepath.Join(fixtureDir, "manifest.json")
+	manifestFile, err := os.Open(manifestPath)
+	if err != nil {
+		return nil, fmt.Errorf("open GENERIC manifest %q: %w", manifestPath, err)
+	}
+	defer manifestFile.Close()
+
+	decoder := json.NewDecoder(manifestFile)
+	decoder.DisallowUnknownFields()
+	manifest := new(genericManifest)
+	if err := decoder.Decode(manifest); err != nil {
+		return nil, fmt.Errorf("decode GENERIC manifest %q: %w", manifestPath, err)
+	}
+	if err := requireJSONEOF(decoder); err != nil {
+		return nil, fmt.Errorf("decode GENERIC manifest %q: %w", manifestPath, err)
+	}
+	if err := validateGenericManifest(manifest, expectedNumDpus, expectedNumTasklets); err != nil {
+		return nil, fmt.Errorf("validate GENERIC manifest %q: %w", manifestPath, err)
+	}
+
+	fixture := &Generic{
+		numDpus:     manifest.NumDpus,
+		numTasklets: manifest.NumTasklets,
+		executions:  make([][]genericDpuFixture, len(manifest.Executions)),
+	}
+	for executionIndex, execution := range manifest.Executions {
+		fixture.executions[executionIndex] = make([]genericDpuFixture, len(execution.Dpus))
+		for dpuIndex, dpu := range execution.Dpus {
+			materialized, err := materializeGenericDpu(fixtureDir, dpu)
+			if err != nil {
+				return nil, fmt.Errorf(
+					"materialize GENERIC execution %d DPU %d: %w",
+					executionIndex,
+					dpuIndex,
+					err,
+				)
+			}
+			fixture.executions[executionIndex][dpuIndex] = materialized
+		}
+	}
+
+	return fixture, nil
+}
+
+func requireJSONEOF(decoder *json.Decoder) error {
+	var trailing any
+	if err := decoder.Decode(&trailing); err == io.EOF {
+		return nil
+	} else if err != nil {
+		return err
+	}
+	return errors.New("manifest contains more than one JSON value")
+}
+
+func validateGenericManifest(
+	manifest *genericManifest,
+	expectedNumDpus int,
+	expectedNumTasklets int,
+) error {
+	if manifest.SchemaVersion != genericManifestVersion {
+		return fmt.Errorf(
+			"schema_version is %d, want %d",
+			manifest.SchemaVersion,
+			genericManifestVersion,
+		)
+	}
+	if manifest.NumDpus <= 0 {
+		return fmt.Errorf("num_dpus must be positive, got %d", manifest.NumDpus)
+	}
+	if manifest.NumDpus != expectedNumDpus {
+		return fmt.Errorf(
+			"num_dpus is %d, but command line config creates %d",
+			manifest.NumDpus,
+			expectedNumDpus,
+		)
+	}
+	if manifest.NumTasklets <= 0 {
+		return fmt.Errorf("num_tasklets must be positive, got %d", manifest.NumTasklets)
+	}
+	if manifest.NumTasklets != expectedNumTasklets {
+		return fmt.Errorf(
+			"num_tasklets is %d, but command line config requests %d",
+			manifest.NumTasklets,
+			expectedNumTasklets,
+		)
+	}
+	if len(manifest.Executions) == 0 {
+		return errors.New("executions must contain at least one execution")
+	}
+
+	for executionIndex, execution := range manifest.Executions {
+		if len(execution.Dpus) != manifest.NumDpus {
+			return fmt.Errorf(
+				"execution %d contains %d DPUs, want %d",
+				executionIndex,
+				len(execution.Dpus),
+				manifest.NumDpus,
+			)
+		}
+		for dpuIndex, dpu := range execution.Dpus {
+			if err := validateGenericDpu(dpu); err != nil {
+				return fmt.Errorf("execution %d DPU %d: %w", executionIndex, dpuIndex, err)
+			}
+		}
+	}
+
+	return nil
+}
+
+func validateGenericDpu(dpu genericDpuManifest) error {
+	for kind, symbols := range map[string]map[string]string{
+		"host_inputs":  dpu.HostInputs,
+		"host_outputs": dpu.HostOutputs,
+	} {
+		for symbol, path := range symbols {
+			if !genericHostSymbolPattern.MatchString(symbol) {
+				return fmt.Errorf("%s symbol %q is not a C identifier", kind, symbol)
+			}
+			if symbol == "dpu_mram_heap_pointer_name" ||
+				strings.HasPrefix(symbol, "dpu_mram_heap_pointer_name_") {
+				return fmt.Errorf(
+					"%s symbol %q conflicts with uPIMulator's MRAM fixture filename format",
+					kind,
+					symbol,
+				)
+			}
+			if err := validateGenericRelativePath(path); err != nil {
+				return fmt.Errorf("%s symbol %q: %w", kind, symbol, err)
+			}
+		}
+	}
+
+	for kind, mram := range map[string]*genericMramManifest{
+		"mram_heap_input":  dpu.MramHeapInput,
+		"mram_heap_output": dpu.MramHeapOutput,
+	} {
+		if mram == nil {
+			continue
+		}
+		if mram.Offset < 0 {
+			return fmt.Errorf("%s offset must be non-negative, got %d", kind, mram.Offset)
+		}
+		if err := validateGenericRelativePath(mram.File); err != nil {
+			return fmt.Errorf("%s: %w", kind, err)
+		}
+	}
+
+	return nil
+}
+
+func validateGenericRelativePath(path string) error {
+	if strings.TrimSpace(path) == "" {
+		return errors.New("file must be non-empty")
+	}
+	if filepath.IsAbs(path) {
+		return fmt.Errorf("file %q must be relative to fixture_dir", path)
+	}
+	cleaned := filepath.Clean(path)
+	if cleaned == ".." || strings.HasPrefix(cleaned, ".."+string(filepath.Separator)) {
+		return fmt.Errorf("file %q escapes fixture_dir", path)
+	}
+	return nil
+}
+
+func materializeGenericDpu(
+	fixtureDir string,
+	manifest genericDpuManifest,
+) (genericDpuFixture, error) {
+	hostInputs, err := materializeGenericHostSymbols(fixtureDir, manifest.HostInputs)
+	if err != nil {
+		return genericDpuFixture{}, fmt.Errorf("host_inputs: %w", err)
+	}
+	hostOutputs, err := materializeGenericHostSymbols(fixtureDir, manifest.HostOutputs)
+	if err != nil {
+		return genericDpuFixture{}, fmt.Errorf("host_outputs: %w", err)
+	}
+	mramHeapInput, err := materializeGenericMram(fixtureDir, manifest.MramHeapInput)
+	if err != nil {
+		return genericDpuFixture{}, fmt.Errorf("mram_heap_input: %w", err)
+	}
+	mramHeapOutput, err := materializeGenericMram(fixtureDir, manifest.MramHeapOutput)
+	if err != nil {
+		return genericDpuFixture{}, fmt.Errorf("mram_heap_output: %w", err)
+	}
+
+	return genericDpuFixture{
+		hostInputs:     hostInputs,
+		hostOutputs:    hostOutputs,
+		mramHeapInput:  mramHeapInput,
+		mramHeapOutput: mramHeapOutput,
+	}, nil
+}
+
+func materializeGenericHostSymbols(
+	fixtureDir string,
+	manifest map[string]string,
+) (map[string]*encoding.ByteStream, error) {
+	fixtures := make(map[string]*encoding.ByteStream, len(manifest))
+	for symbol, relativePath := range manifest {
+		bytes, err := readGenericRawBinary(fixtureDir, relativePath)
+		if err != nil {
+			return nil, fmt.Errorf("symbol %q: %w", symbol, err)
+		}
+		fixtures[symbol] = bytes
+	}
+	return fixtures, nil
+}
+
+func materializeGenericMram(
+	fixtureDir string,
+	manifest *genericMramManifest,
+) (genericMramFixture, error) {
+	if manifest == nil {
+		return genericMramFixture{offset: 0, bytes: newGenericByteStream(nil)}, nil
+	}
+	bytes, err := readGenericRawBinary(fixtureDir, manifest.File)
+	if err != nil {
+		return genericMramFixture{}, err
+	}
+	return genericMramFixture{offset: manifest.Offset, bytes: bytes}, nil
+}
+
+func readGenericRawBinary(fixtureDir string, relativePath string) (*encoding.ByteStream, error) {
+	fixtureRoot, err := filepath.Abs(fixtureDir)
+	if err != nil {
+		return nil, fmt.Errorf("resolve fixture_dir %q: %w", fixtureDir, err)
+	}
+	fixtureRoot, err = filepath.EvalSymlinks(fixtureRoot)
+	if err != nil {
+		return nil, fmt.Errorf("resolve fixture_dir %q: %w", fixtureDir, err)
+	}
+
+	path := filepath.Join(fixtureRoot, filepath.Clean(relativePath))
+	path, err = filepath.EvalSymlinks(path)
+	if err != nil {
+		return nil, fmt.Errorf("resolve raw binary %q: %w", path, err)
+	}
+	pathFromFixture, err := filepath.Rel(fixtureRoot, path)
+	if err != nil {
+		return nil, fmt.Errorf("locate raw binary %q under fixture_dir: %w", path, err)
+	}
+	if pathFromFixture == ".." || strings.HasPrefix(pathFromFixture, ".."+string(filepath.Separator)) {
+		return nil, fmt.Errorf("raw binary %q resolves outside fixture_dir", relativePath)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return nil, fmt.Errorf("stat raw binary %q: %w", path, err)
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("raw binary %q is not a regular file", path)
+	}
+
+	bytes, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read raw binary %q: %w", path, err)
+	}
+	return newGenericByteStream(bytes), nil
+}
+
+func newGenericByteStream(bytes []byte) *encoding.ByteStream {
+	byteStream := new(encoding.ByteStream)
+	byteStream.Init()
+	for _, value := range bytes {
+		byteStream.Append(value)
+	}
+	return byteStream
+}
+
+func (this *Generic) InputDpuHost(
+	execution int,
+	dpuId int,
+) map[string]*encoding.ByteStream {
+	return this.dpuFixture(execution, dpuId).hostInputs
+}
+
+func (this *Generic) OutputDpuHost(
+	execution int,
+	dpuId int,
+) map[string]*encoding.ByteStream {
+	return this.dpuFixture(execution, dpuId).hostOutputs
+}
+
+func (this *Generic) InputDpuMramHeapPointerName(
+	execution int,
+	dpuId int,
+) (int64, *encoding.ByteStream) {
+	mram := this.dpuFixture(execution, dpuId).mramHeapInput
+	return mram.offset, mram.bytes
+}
+
+func (this *Generic) OutputDpuMramHeapPointerName(
+	execution int,
+	dpuId int,
+) (int64, *encoding.ByteStream) {
+	mram := this.dpuFixture(execution, dpuId).mramHeapOutput
+	return mram.offset, mram.bytes
+}
+
+func (this *Generic) NumExecutions() int {
+	return len(this.executions)
+}
+
+func (this *Generic) dpuFixture(execution int, dpuId int) *genericDpuFixture {
+	if execution < 0 || execution >= len(this.executions) {
+		panic(fmt.Errorf("execution %d is outside [0, %d)", execution, len(this.executions)))
+	}
+	if dpuId < 0 || dpuId >= this.numDpus {
+		panic(fmt.Errorf("DPU ID %d is outside [0, %d)", dpuId, this.numDpus))
+	}
+	return &this.executions[execution][dpuId]
+}
diff --git a/golang/uPIMulator/src/assembler/prim/generic_test.go b/golang/uPIMulator/src/assembler/prim/generic_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ec4ebc698557f75b1c62b6089ad749cf18fb27e8
--- /dev/null
+++ b/golang/uPIMulator/src/assembler/prim/generic_test.go
@@ -0,0 +1,214 @@
+package prim
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"uPIMulator/src/abi/encoding"
+)
+
+func TestLoadGenericFixtureMaterializesRawBinaries(t *testing.T) {
+	fixtureDir := t.TempDir()
+	writeGenericTestFile(t, fixtureDir, "raw/host-input.bin", []byte{0, 1, 127, 255})
+	writeGenericTestFile(t, fixtureDir, "raw/host-output.bin", []byte{4, 3, 2, 1})
+	writeGenericTestFile(t, fixtureDir, "raw/heap-input.bin", []byte{10, 20, 30})
+	writeGenericTestFile(t, fixtureDir, "raw/heap-output.bin", []byte{40, 50})
+	writeGenericTestFile(t, fixtureDir, "raw/second-execution.bin", []byte{99})
+
+	manifest := `{
+	  "schema_version": 1,
+  "num_dpus": 2,
+  "num_tasklets": 12,
+  "executions": [
+    {"dpus": [
+      {
+        "host_inputs": {"DPU_INPUT_ARGUMENTS": "raw/host-input.bin"},
+        "host_outputs": {"result_0": "raw/host-output.bin"},
+        "mram_heap_input": {"offset": 8, "file": "raw/heap-input.bin"},
+        "mram_heap_output": {"offset": 24, "file": "raw/heap-output.bin"}
+      },
+      {}
+    ]},
+    {"dpus": [
+      {},
+      {"host_inputs": {"again": "raw/second-execution.bin"}}
+    ]}
+  ]
+}`
+	writeGenericTestFile(t, fixtureDir, "manifest.json", []byte(manifest))
+
+	fixture, err := loadGenericFixture(fixtureDir, 2, 12)
+	if err != nil {
+		t.Fatalf("loadGenericFixture() error = %v", err)
+	}
+	if got := fixture.NumExecutions(); got != 2 {
+		t.Fatalf("NumExecutions() = %d, want 2", got)
+	}
+	if fixture.numDpus != 2 || fixture.numTasklets != 12 {
+		t.Fatalf(
+			"fixture dimensions = (%d DPUs, %d tasklets), want (2, 12)",
+			fixture.numDpus,
+			fixture.numTasklets,
+		)
+	}
+
+	assertGenericBytes(
+		t,
+		fixture.InputDpuHost(0, 0)["DPU_INPUT_ARGUMENTS"],
+		[]byte{0, 1, 127, 255},
+	)
+	assertGenericBytes(t, fixture.OutputDpuHost(0, 0)["result_0"], []byte{4, 3, 2, 1})
+	inputOffset, inputBytes := fixture.InputDpuMramHeapPointerName(0, 0)
+	if inputOffset != 8 {
+		t.Errorf("input MRAM offset = %d, want 8", inputOffset)
+	}
+	assertGenericBytes(t, inputBytes, []byte{10, 20, 30})
+	outputOffset, outputBytes := fixture.OutputDpuMramHeapPointerName(0, 0)
+	if outputOffset != 24 {
+		t.Errorf("output MRAM offset = %d, want 24", outputOffset)
+	}
+	assertGenericBytes(t, outputBytes, []byte{40, 50})
+
+	if got := len(fixture.InputDpuHost(0, 1)); got != 0 {
+		t.Errorf("omitted host_inputs contains %d entries, want 0", got)
+	}
+	emptyOffset, emptyBytes := fixture.InputDpuMramHeapPointerName(0, 1)
+	if emptyOffset != 0 || emptyBytes.Size() != 0 {
+		t.Errorf(
+			"omitted MRAM input = (offset %d, size %d), want (0, 0)",
+			emptyOffset,
+			emptyBytes.Size(),
+		)
+	}
+	assertGenericBytes(t, fixture.InputDpuHost(1, 1)["again"], []byte{99})
+}
+
+func TestLoadGenericFixtureRejectsInvalidManifests(t *testing.T) {
+	tests := []struct {
+		name      string
+		manifest  string
+		wantError string
+	}{
+		{
+			name: "unknown field",
+			manifest: `{
+			  "schema_version": 1, "num_dpus": 1, "num_tasklets": 12,
+  "executions": [{"dpus": [{}]}], "surprise": true
+}`,
+			wantError: "unknown field",
+		},
+		{
+			name: "unsupported version",
+			manifest: `{
+			  "schema_version": 2, "num_dpus": 1, "num_tasklets": 12,
+  "executions": [{"dpus": [{}]}]
+}`,
+			wantError: "schema_version is 2, want 1",
+		},
+		{
+			name: "DPU count mismatch",
+			manifest: `{
+			  "schema_version": 1, "num_dpus": 1, "num_tasklets": 12,
+  "executions": [{"dpus": []}]
+}`,
+			wantError: "contains 0 DPUs, want 1",
+		},
+		{
+			name: "tasklet count mismatch",
+			manifest: `{
+			  "schema_version": 1, "num_dpus": 1, "num_tasklets": 11,
+  "executions": [{"dpus": [{}]}]
+}`,
+			wantError: "num_tasklets is 11",
+		},
+		{
+			name: "invalid host symbol",
+			manifest: `{
+			  "schema_version": 1, "num_dpus": 1, "num_tasklets": 12,
+  "executions": [{"dpus": [{"host_inputs": {"not-a-symbol": "x.bin"}}]}]
+}`,
+			wantError: "is not a C identifier",
+		},
+		{
+			name: "escaping path",
+			manifest: `{
+			  "schema_version": 1, "num_dpus": 1, "num_tasklets": 12,
+  "executions": [{"dpus": [{"mram_heap_input": {"offset": 0, "file": "../x.bin"}}]}]
+}`,
+			wantError: "escapes fixture_dir",
+		},
+		{
+			name: "negative MRAM offset",
+			manifest: `{
+			  "schema_version": 1, "num_dpus": 1, "num_tasklets": 12,
+  "executions": [{"dpus": [{"mram_heap_output": {"offset": -1, "file": "x.bin"}}]}]
+}`,
+			wantError: "offset must be non-negative",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			fixtureDir := t.TempDir()
+			writeGenericTestFile(t, fixtureDir, "manifest.json", []byte(test.manifest))
+			_, err := loadGenericFixture(fixtureDir, 1, 12)
+			if err == nil {
+				t.Fatal("loadGenericFixture() succeeded, want error")
+			}
+			if !strings.Contains(err.Error(), test.wantError) {
+				t.Fatalf("loadGenericFixture() error = %q, want substring %q", err, test.wantError)
+			}
+		})
+	}
+}
+
+func TestLoadGenericFixtureRejectsSymlinkOutsideFixtureDir(t *testing.T) {
+	fixtureDir := t.TempDir()
+	outsideDir := t.TempDir()
+	writeGenericTestFile(t, outsideDir, "outside.bin", []byte{1, 2, 3})
+	if err := os.Symlink(
+		filepath.Join(outsideDir, "outside.bin"),
+		filepath.Join(fixtureDir, "outside.bin"),
+	); err != nil {
+		t.Fatalf("Symlink() error = %v", err)
+	}
+	writeGenericTestFile(t, fixtureDir, "manifest.json", []byte(`{
+	  "schema_version": 1, "num_dpus": 1, "num_tasklets": 12,
+  "executions": [{"dpus": [{"host_inputs": {"A": "outside.bin"}}]}]
+}`))
+
+	_, err := loadGenericFixture(fixtureDir, 1, 12)
+	if err == nil {
+		t.Fatal("loadGenericFixture() followed outside symlink, want error")
+	}
+	if !strings.Contains(err.Error(), "resolves outside fixture_dir") {
+		t.Fatalf("loadGenericFixture() error = %q, want outside-fixture error", err)
+	}
+}
+
+func writeGenericTestFile(t *testing.T, root string, relativePath string, bytes []byte) {
+	t.Helper()
+	path := filepath.Join(root, relativePath)
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatalf("MkdirAll(%q) error = %v", filepath.Dir(path), err)
+	}
+	if err := os.WriteFile(path, bytes, 0o644); err != nil {
+		t.Fatalf("WriteFile(%q) error = %v", path, err)
+	}
+}
+
+func assertGenericBytes(t *testing.T, stream *encoding.ByteStream, want []byte) {
+	t.Helper()
+	if stream == nil {
+		t.Fatal("byte stream is nil")
+	}
+	if got := stream.Size(); got != int64(len(want)) {
+		t.Fatalf("byte stream size = %d, want %d", got, len(want))
+	}
+	for index, expected := range want {
+		if actual := stream.Get(index); actual != expected {
+			t.Fatalf("byte stream[%d] = %d, want %d", index, actual, expected)
+		}
+	}
+}
