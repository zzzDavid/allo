new file mode 100644
index 0000000000000000000000000000000000000000..825a42ae24bdb714b2b249075d62516d42ec3b7c
--- /dev/null
+++ b/golang/uPIMulator/src/assembler/prim/simplepim_va.go
@@ -0,0 +1,141 @@
+package prim
+
+import (
+	"fmt"
+	"uPIMulator/src/abi/encoding"
+	"uPIMulator/src/abi/word"
+	"uPIMulator/src/misc"
+)
+
+// SimplePimVa describes the exact per-DPU layout produced by the checked-in
+// SimplePIM vector-add host.  The zip is virtual: the sole timed DPU launch is
+// the native map kernel, which reads A and B independently and writes A+B.
+type SimplePimVa struct {
+	numDpus       int
+	numTasklets   int
+	numExecutions int
+	numElements   int64
+
+	inputBytes       int64
+	virtualTableBase int64
+	outputBase       int64
+
+	bufferA []int64
+	bufferB []int64
+	bufferC []int64
+}
+
+func (this *SimplePimVa) Init(commandLineParser *misc.CommandLineParser) {
+	numChannels := int(commandLineParser.IntParameter("num_channels"))
+	numRanksPerChannel := int(commandLineParser.IntParameter("num_ranks_per_channel"))
+	numDpusPerRank := int(commandLineParser.IntParameter("num_dpus_per_rank"))
+
+	this.numDpus = numChannels * numRanksPerChannel * numDpusPerRank
+	this.numTasklets = int(commandLineParser.IntParameter("num_tasklets"))
+	this.numExecutions = 1
+
+	if this.numDpus != 1 {
+		panic(fmt.Errorf("SIMPLEPIM-VA requires exactly one DPU, got %d", this.numDpus))
+	}
+	if this.numTasklets != 12 {
+		panic(fmt.Errorf("SIMPLEPIM-VA preserves SimplePIM's fixed 12 tasklets, got %d", this.numTasklets))
+	}
+
+	dataPrepParams := commandLineParser.DataPrepParams()
+	if len(dataPrepParams) != 1 || dataPrepParams[0] <= 0 {
+		panic(fmt.Errorf("SIMPLEPIM-VA expects one positive element count"))
+	}
+	this.numElements = int64(dataPrepParams[0])
+	if this.numElements%2 != 0 {
+		panic(fmt.Errorf("SIMPLEPIM-VA requires an even element count for 8-byte DMA alignment"))
+	}
+
+	// Two materialized uint32 input tables precede a virtual uint32-pair
+	// table.  SimplePIM advances free_space_start_pos by an extra eight bytes
+	// when the virtual table end is already aligned.
+	this.inputBytes = 4 * this.numElements
+	this.virtualTableBase = 2 * this.inputBytes
+	virtualTableEnd := this.virtualTableBase + 8*this.numElements
+	this.outputBase = virtualTableEnd + (8 - virtualTableEnd%8)
+
+	this.bufferA = make([]int64, this.numElements)
+	this.bufferB = make([]int64, this.numElements)
+	this.bufferC = make([]int64, this.numElements)
+	for i := int64(0); i < this.numElements; i++ {
+		this.bufferA[i] = i % 128
+		this.bufferB[i] = (i + 1) % 128
+		this.bufferC[i] = this.bufferA[i] + this.bufferB[i]
+	}
+}
+
+func appendUint32(byteStream *encoding.ByteStream, value int64) {
+	valueWord := new(word.Word)
+	valueWord.Init(32)
+	valueWord.SetValue(value)
+	byteStream.Merge(valueWord.ToByteStream())
+}
+
+func (this *SimplePimVa) InputDpuHost(execution int, dpuId int) map[string]*encoding.ByteStream {
+	this.validateIndices(execution, dpuId)
+
+	arguments := new(encoding.ByteStream)
+	arguments.Init()
+
+	// map_arguments_t: eleven consecutive little-endian uint32 fields.
+	appendUint32(arguments, this.virtualTableBase) // input_start_offset
+	appendUint32(arguments, 8)                     // input_type_size
+	appendUint32(arguments, this.outputBase)       // output_start_offset
+	appendUint32(arguments, 4)                     // output_type_size
+	appendUint32(arguments, this.numElements)      // len
+	appendUint32(arguments, 0)                     // info
+	appendUint32(arguments, 1)                     // is_virtually_zipped
+	appendUint32(arguments, 0)                     // start1
+	appendUint32(arguments, this.inputBytes)       // start2
+	appendUint32(arguments, 4)                     // type1
+	appendUint32(arguments, 4)                     // type2
+
+	return map[string]*encoding.ByteStream{"MAP_INPUT_ARGUMENTS": arguments}
+}
+
+func (this *SimplePimVa) OutputDpuHost(execution int, dpuId int) map[string]*encoding.ByteStream {
+	this.validateIndices(execution, dpuId)
+	return make(map[string]*encoding.ByteStream)
+}
+
+func (this *SimplePimVa) InputDpuMramHeapPointerName(execution int, dpuId int) (int64, *encoding.ByteStream) {
+	this.validateIndices(execution, dpuId)
+
+	inputs := new(encoding.ByteStream)
+	inputs.Init()
+	for _, value := range this.bufferA {
+		appendUint32(inputs, value)
+	}
+	for _, value := range this.bufferB {
+		appendUint32(inputs, value)
+	}
+	return 0, inputs
+}
+
+func (this *SimplePimVa) OutputDpuMramHeapPointerName(execution int, dpuId int) (int64, *encoding.ByteStream) {
+	this.validateIndices(execution, dpuId)
+
+	output := new(encoding.ByteStream)
+	output.Init()
+	for _, value := range this.bufferC {
+		appendUint32(output, value)
+	}
+	return this.outputBase, output
+}
+
+func (this *SimplePimVa) NumExecutions() int {
+	return this.numExecutions
+}
+
+func (this *SimplePimVa) validateIndices(execution int, dpuId int) {
+	if execution < 0 || execution >= this.numExecutions {
+		panic(fmt.Errorf("execution %d is outside [0, %d)", execution, this.numExecutions))
+	}
+	if dpuId < 0 || dpuId >= this.numDpus {
+		panic(fmt.Errorf("DPU ID %d is outside [0, %d)", dpuId, this.numDpus))
+	}
+}
