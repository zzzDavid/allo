+func TestUnusedStdioObjectDoesNotShiftMramLayout(t *testing.T) {
+	dir := t.TempDir()
+	benchmarkPath := writeSyntheticAssembly(t, dir, "benchmark.S", `
+	.section .mram.noinit,"aw",@progbits
+	.globl app_input
+app_input:
+	.zero 16
+	.section .mram,"aw",@progbits
+	.globl app_output
+app_output:
+	.zero 16
+`)
+	crt0Path := writeSyntheticAssembly(t, dir, "crt0.S", `
+	.text
+	.globl __bootstrap
+__bootstrap:
+	.long __stdout_buffer_state
+`)
+	stdoutStatePath := writeSyntheticAssembly(t, dir, "stdout-state.S", `
+	.section .data.immediate_memory.__stdout_buffer_state,"aw",@progbits
+	.globl __stdout_buffer_state
+__stdout_buffer_state:
+	.zero 8
+`)
+	stdioPath := writeSyntheticAssembly(t, dir, "stdio.S", `
+	.text
+	.globl printf
+printf:
+	.long __stdout_buffer_state
+	.section .mram.noinit,"aw",@progbits
+	.weak __stdout_buffer
+__stdout_buffer:
+	.zero 1048576
+`)
+
+	benchmark := syntheticRelocatable(
+		"GENERIC",
+		benchmarkPath,
+		[]string{"app_input", "app_output"},
+		nil,
+		[]string{"app_input", "app_output"},
+	)
+	crt0 := syntheticRelocatable(
+		"misc.crt0",
+		crt0Path,
+		[]string{"__bootstrap"},
+		[]string{"__stdout_buffer_state"},
+		[]string{"__bootstrap"},
+	)
+	stdoutState := syntheticRelocatable(
+		"misc.stdoutBufferState",
+		stdoutStatePath,
+		[]string{"__stdout_buffer_state"},
+		nil,
+		[]string{"__stdout_buffer_state"},
+	)
+	stdio := syntheticRelocatable(
+		"stdlib.stdio",
+		stdioPath,
+		[]string{"printf", "__stdout_buffer"},
+		[]string{"__stdout_buffer_state"},
+		[]string{"printf"},
+	)
+
+	commandLineParser := syntheticLinkerCommandLineParser()
+	linkerScript := new(logic.LinkerScript)
+	linkerScript.Init(commandLineParser)
+	executable := new(kernel.Executable)
+	executable.Init("GENERIC")
+	executable.SetBenchmarkRelocatable(benchmark)
+
+	linker := &Linker{
+		sdk_relocatables: map[string]*kernel.Relocatable{
+			"misc.crt0":              crt0,
+			"misc.stdoutBufferState": stdoutState,
+			"stdlib.stdio":           stdio,
+		},
+		executable:    executable,
+		linker_script: linkerScript,
+	}
+	linker.ResolveSymbols()
+
+	resolvedPath := filepath.Join(dir, "resolved.S")
+	executable.SetPath(resolvedPath)
+	executable.DumpAssembly()
+	resolvedAssembly, err := os.ReadFile(resolvedPath)
+	if err != nil {
+		t.Fatalf("ReadFile(%q) error = %v", resolvedPath, err)
+	}
+	if !strings.Contains(string(resolvedAssembly), "__stdout_buffer_state:") {
+		t.Fatal("always-live stdout state object was not selected")
+	}
+	if strings.Contains(string(resolvedAssembly), "__stdout_buffer:") {
+		t.Fatal("unused stdio implementation and its MRAM buffer were selected")
+	}
+
+	resolvedAddresses := assignSyntheticMramAddresses(t, resolvedPath, commandLineParser)
+	withoutStdioOutput := resolvedAddresses["app_output"]
+
+	// This is the old object-granularity failure mode: satisfying the
+	// bootstrap's state reference with stdio.c also admits its unrelated 1 MiB
+	// .mram.noinit section. Compare against it to make the symbol shift visible.
+	forcedStdioPath := filepath.Join(dir, "forced-stdio.S")
+	forcedAssembly := append([]byte{}, resolvedAssembly...)
+	stdioAssembly, err := os.ReadFile(stdioPath)
+	if err != nil {
+		t.Fatalf("ReadFile(%q) error = %v", stdioPath, err)
+	}
+	forcedAssembly = append(forcedAssembly, stdioAssembly...)
+	if err := os.WriteFile(forcedStdioPath, forcedAssembly, 0o644); err != nil {
+		t.Fatalf("WriteFile(%q) error = %v", forcedStdioPath, err)
+	}
+	forcedAddresses := assignSyntheticMramAddresses(t, forcedStdioPath, commandLineParser)
+	withStdioOutput := forcedAddresses["app_output"]
+
+	if got, want := withStdioOutput-withoutStdioOutput, int64(syntheticStdoutBufferSize); got != want {
+		t.Fatalf(
+			"unused stdio shifted app_output by %d bytes, want demonstration shift %d",
+			got,
+			want,
+		)
+	}
+	if got, want := withoutStdioOutput, int64(512*1024+16); got != want {
+		t.Fatalf("reachable-only app_output address = %d, want %d", got, want)
+	}
+}
+
+func syntheticRelocatable(
+	name string,
+	path string,
+	defs []string,
+	uses []string,
+	globals []string,
+) *kernel.Relocatable {
+	relocatable := new(kernel.Relocatable)
+	relocatable.Init(name)
+	relocatable.SetPath(path)
+	liveness := new(kernel.Liveness)
+	liveness.Init()
+	for _, def := range defs {
+		liveness.AddDef(def)
+	}
+	for _, use := range uses {
+		liveness.AddUse(use)
+	}
+	for _, global := range globals {
+		liveness.AddGlobalSymbol(global)
+	}
+	relocatable.SetLiveness(liveness)
+	return relocatable
+}
+
+func syntheticLinkerCommandLineParser() *misc.CommandLineParser {
+	commandLineParser := new(misc.CommandLineParser)
+	commandLineParser.Init()
+	commandLineParser.AddOption(misc.INT, "num_tasklets", "1", "")
+	commandLineParser.AddOption(misc.INT, "min_access_granularity", "8", "")
+	return commandLineParser
+}
+
+func assignSyntheticMramAddresses(
+	t *testing.T,
+	path string,
+	commandLineParser *misc.CommandLineParser,
+) map[string]int64 {
+	t.Helper()
+	lexer_ := new(lexer.Lexer)
+	lexer_.Init()
+	tokenStream := lexer_.Lex(path)
+	parser_ := new(parser.Parser)
+	parser_.Init()
+	ast := parser_.Parse(tokenStream)
+
+	executable := new(kernel.Executable)
+	executable.Init("synthetic")
+	executable.SetTokenStream(tokenStream)
+	executable.SetAst(ast)
+	labelAssigner := new(logic.LabelAssigner)
+	labelAssigner.Init()
+	labelAssigner.Assign(executable)
+	linkerScript := new(logic.LinkerScript)
+	linkerScript.Init(commandLineParser)
+	linkerScript.AssignMram(executable)
+	addresses := make(map[string]int64)
+	for section := range executable.Sections(kernel.MRAM) {
+		for _, label := range section.Labels() {
+			addresses[label.Name()] = label.Address()
+		}
+	}
+	return addresses
+}
+
+func writeSyntheticAssembly(t *testing.T, dir string, name string, contents string) string {
+	t.Helper()
+	path := filepath.Join(dir, name)
+	if err := os.WriteFile(path, []byte(strings.TrimSpace(contents)+"\n"), 0o644); err != nil {
+		t.Fatalf("WriteFile(%q) error = %v", path, err)
+	}
+	return path
+}
