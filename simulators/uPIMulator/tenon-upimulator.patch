index 0000000000000000000000000000000000000000..799e1dcf06f6cc3af00f8e6bc4d2c815bcf293e5
--- /dev/null
+++ b/golang/uPIMulator/src/simulator/host/channel_transfer_read_job_test.go
@@ -0,0 +1,46 @@
+package host
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+	"uPIMulator/src/abi/encoding"
+)
+
+func TestDumpObservedByteStreamsWritesRawEvidence(t *testing.T) {
+	dir := t.TempDir()
+	paths := []string{
+		filepath.Join(dir, "first.raw.bin"),
+		filepath.Join(dir, "second.raw.bin"),
+	}
+	streams := []*encoding.ByteStream{
+		testByteStream([]byte{0, 1, 127, 255}),
+		testByteStream([]byte{9, 8, 7}),
+	}
+	job := &ChannelTransferReadJob{observed_paths: paths}
+	job.DumpObservedByteStreams(streams)
+
+	for i, path := range paths {
+		observed, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatalf("ReadFile(%q) error = %v", path, err)
+		}
+		expected := make([]byte, streams[i].Size())
+		for position := range expected {
+			expected[position] = streams[i].Get(position)
+		}
+		if !bytes.Equal(observed, expected) {
+			t.Fatalf("raw evidence %q = %v, want %v", path, observed, expected)
+		}
+	}
+}
+
+func testByteStream(contents []byte) *encoding.ByteStream {
+	stream := new(encoding.ByteStream)
+	stream.Init()
+	for _, value := range contents {
+		stream.Append(value)
+	}
+	return stream
+}
