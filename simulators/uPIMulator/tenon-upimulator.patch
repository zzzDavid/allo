index 0000000000000000000000000000000000000000..549beb6af164a8d51bfdeac3aecb26e40fc89431
--- /dev/null
+++ b/golang/uPIMulator/benchmark/GENERIC/dpu/CMakeLists.txt
@@ -0,0 +1,16 @@
+set(CMAKE_C_COMPILER "dpu-upmem-dpurte-clang")
+set(CMAKE_C_FLAGS "-w -O2 -S")
+
+# A staged benchmark always supplies task.c. Any additional .c files staged in
+# this directory are preserved as separate translation units so uPIMulator's
+# unresolved-symbol linker can select them without source concatenation.
+file(GLOB GENERIC_DEVICE_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.c")
+
+add_executable(GENERIC_device ${GENERIC_DEVICE_SOURCES})
+target_include_directories(
+    GENERIC_device
+    PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}
+        ${CMAKE_CURRENT_SOURCE_DIR}/..
+)
+target_compile_definitions(GENERIC_device PRIVATE NR_TASKLETS=${NR_TASKLETS})
