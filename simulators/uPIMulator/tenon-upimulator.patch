new file mode 100644
index 0000000000000000000000000000000000000000..2a6c15242f2f243063387a272f32ab605f46751b
--- /dev/null
+++ b/golang/uPIMulator/src/linker/logic/linker_script_wram_test.go
@@ -0,0 +1,128 @@
+package logic
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+	"uPIMulator/src/linker/kernel"
+	"uPIMulator/src/linker/kernel/directive"
+	"uPIMulator/src/misc"
+)
+
+type wramSectionSpec struct {
+	sectionName kernel.SectionName
+	name        string
+	size        int64
+}
+
+func TestAssignWramAlignsSectionsAndIsReproducible(t *testing.T) {
+	specs := []wramSectionSpec{
+		{kernel.DATA, "__sys_zero", 4},
+		{kernel.DATA, "immediate_memory", 4},
+		{kernel.DATA, "immediate_memory.z", 4},
+		{kernel.DATA, "immediate_memory.a", 4},
+		{kernel.RODATA, "", 4},
+		{kernel.RODATA, "z", 4},
+		{kernel.RODATA, "a", 4},
+		{kernel.BSS, "", 4},
+		{kernel.BSS, "aa_prefix", 4},
+		{kernel.BSS, "e2e_mm_header_word", 8},
+		{kernel.BSS, "z", 4},
+		{kernel.DATA, "__sys_keep", 4},
+		{kernel.DATA, "", 4},
+		{kernel.DATA, "z", 4},
+		{kernel.DATA, "a", 4},
+		{kernel.DPU_HOST, "", 4},
+	}
+
+	forwardExecutable, forwardScript, forward := assignTestWramSections(t, specs)
+	reversedSpecs := append([]wramSectionSpec(nil), specs...)
+	for i, j := 0, len(reversedSpecs)-1; i < j; i, j = i+1, j-1 {
+		reversedSpecs[i], reversedSpecs[j] = reversedSpecs[j], reversedSpecs[i]
+	}
+	_, _, reversed := assignTestWramSections(t, reversedSpecs)
+
+	if !reflect.DeepEqual(forward, reversed) {
+		t.Fatalf("WRAM layout depends on section insertion order:\nforward: %v\nreverse: %v", forward, reversed)
+	}
+
+	for key, address := range forward {
+		if address%8 != 0 {
+			t.Errorf("section %s address = %d, want 8-byte alignment", key, address)
+		}
+	}
+
+	headerKey := wramSectionKey(kernel.BSS, "e2e_mm_header_word")
+	if got, want := forward[headerKey], int64(584); got != want {
+		t.Errorf("e2e_mm_header_word address = %d, want %d", got, want)
+	}
+
+	if got, want := forward[wramSectionKey(kernel.DATA, "immediate_memory.a")], int64(528); got != want {
+		t.Errorf("sorted immediate-memory address = %d, want %d", got, want)
+	}
+	if got, want := forward[wramSectionKey(kernel.RODATA, "a")], int64(552); got != want {
+		t.Errorf("sorted RODATA address = %d, want %d", got, want)
+	}
+	if got, want := forward[wramSectionKey(kernel.BSS, "aa_prefix")], int64(576); got != want {
+		t.Errorf("sorted BSS address = %d, want %d", got, want)
+	}
+	if got, want := forward[wramSectionKey(kernel.DATA, "a")], int64(616); got != want {
+		t.Errorf("sorted DATA address = %d, want %d", got, want)
+	}
+
+	for _, name := range []string{
+		"__sys_stack_thread_0",
+		"__sw_cache_buffer",
+		"__sys_heap_pointer_reset",
+	} {
+		if address := forwardScript.LinkerConstant(name).Value(); address%8 != 0 {
+			t.Errorf("linker constant %s = %d, want 8-byte alignment", name, address)
+		}
+	}
+
+	configLoader := new(misc.ConfigLoader)
+	configLoader.Init()
+	lastSection := forwardExecutable.Section(kernel.DPU_HOST, "")
+	wantStreamSize := lastSection.Address() + lastSection.Size() - configLoader.WramOffset()
+	if got := forwardExecutable.WramByteStream().Size(); got != wantStreamSize {
+		t.Errorf("WRAM image size = %d, want address-preserving size %d", got, wantStreamSize)
+	}
+}
+
+func assignTestWramSections(
+	t *testing.T,
+	specs []wramSectionSpec,
+) (*kernel.Executable, *LinkerScript, map[string]int64) {
+	t.Helper()
+	executable := new(kernel.Executable)
+	executable.Init("wram-layout-test")
+
+	for _, spec := range specs {
+		executable.AddSection(spec.sectionName, spec.name, map[kernel.SectionFlag]bool{}, kernel.PROGBITS)
+		executable.CheckoutSection(spec.sectionName, spec.name)
+		label := executable.CurSection().CurLabel()
+		label.SetSize(spec.size)
+		zeros := new(directive.ZeroDirective)
+		zeros.Init(spec.size, 0)
+		label.Append(zeros)
+	}
+
+	commandLineParser := new(misc.CommandLineParser)
+	commandLineParser.Init()
+	commandLineParser.AddOption(misc.INT, "num_tasklets", "1", "")
+	commandLineParser.AddOption(misc.INT, "min_access_granularity", "8", "")
+	linkerScript := new(LinkerScript)
+	linkerScript.Init(commandLineParser)
+	linkerScript.AssignWram(executable)
+
+	addresses := make(map[string]int64, len(specs))
+	for _, spec := range specs {
+		section := executable.Section(spec.sectionName, spec.name)
+		addresses[wramSectionKey(spec.sectionName, spec.name)] = section.Address()
+	}
+	return executable, linkerScript, addresses
+}
+
+func wramSectionKey(sectionName kernel.SectionName, name string) string {
+	return fmt.Sprintf("%d:%s", sectionName, name)
+}
