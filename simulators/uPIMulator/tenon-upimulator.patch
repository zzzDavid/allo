+package logic
+
+import "testing"
+
+func TestSubcPropagatesBorrow(t *testing.T) {
+	alu := new(Alu)
+	alu.Init()
+
+	tests := []struct {
+		name       string
+		minuend    int64
+		subtrahend int64
+		borrowIn   bool
+		wantResult int64
+		wantBorrow bool
+	}{
+		{"equal with borrow", 0, 0, true, 0xffffffff, true},
+		{"larger by one with borrow", 1, 0, true, 0, false},
+		{"ordinary underflow", 0, 1, false, 0xffffffff, true},
+		{"maximum subtrahend with borrow", 0xffffffff, 0xffffffff, true, 0xffffffff, true},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			result, borrow, _ := alu.Subc(test.minuend, test.subtrahend, test.borrowIn)
+			if result != test.wantResult || borrow != test.wantBorrow {
+				t.Fatalf(
+					"Subc(%#x, %#x, %t) = (%#x, %t), want (%#x, %t)",
+					test.minuend,
+					test.subtrahend,
+					test.borrowIn,
+					result,
+					borrow,
+					test.wantResult,
+					test.wantBorrow,
+				)
+			}
+		})
+	}
+}
