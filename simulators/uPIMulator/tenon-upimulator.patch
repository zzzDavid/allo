+package logic
+
+import "testing"
+
+func TestDmaAddressesAlignSoftCacheReadModifyWrite(t *testing.T) {
+	tests := []struct {
+		name     string
+		ra       int64
+		rb       int64
+		wantWram int64
+		wantMram int64
+	}{
+		{
+			name:     "upper word addresses align to the containing eight-byte block",
+			ra:       0x0000c36c,
+			rb:       0x00088c04,
+			wantWram: 0x0000c368,
+			wantMram: 0x00088c00,
+		},
+		{
+			name:     "WRAM length bits do not become address bits",
+			ra:       0x7f00c36c,
+			rb:       0x00088c04,
+			wantWram: 0x0000c368,
+			wantMram: 0x00088c00,
+		},
+		{
+			name:     "aligned addresses remain unchanged",
+			ra:       0x0000c368,
+			rb:       0x00088c00,
+			wantWram: 0x0000c368,
+			wantMram: 0x00088c00,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			gotWram, gotMram := dmaAddresses(test.ra, test.rb)
+			if gotWram != test.wantWram || gotMram != test.wantMram {
+				t.Fatalf(
+					"dmaAddresses(%#x, %#x) = (%#x, %#x), want (%#x, %#x)",
+					test.ra,
+					test.rb,
+					gotWram,
+					gotMram,
+					test.wantWram,
+					test.wantMram,
+				)
+			}
+		})
+	}
+}
