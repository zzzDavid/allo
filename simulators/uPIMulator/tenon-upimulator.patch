+
+#include <attributes.h>
+#include <dpuruntime.h>
+
+/*
+ * The bootstrap clears this state whether or not the application uses stdio.
+ * Keep it in its own object so uPIMulator's object-granularity SDK resolver
+ * does not pull in stdio.c and its unused 1 MiB default MRAM buffer merely to
+ * satisfy the bootstrap reference.
+ *
+ * __lower_data keeps the address within the bootstrap sd instruction's signed
+ * 12-bit offset; __dma_aligned supplies the required eight-byte alignment.
+ */
+stdout_buffer_state_t __lower_data(__STR(__STDOUT_BUFFER_STATE)) __dma_aligned
+    __STDOUT_BUFFER_STATE;
