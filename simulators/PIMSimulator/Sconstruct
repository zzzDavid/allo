import os
from os.path import join as joinpath


def setNumJobs():
    # to parallel build by default
    SetOption('num_jobs', 32)
    print("running with -j", GetOption('num_jobs'))


def getFlags(env):
    no_storage = ARGUMENTS.get('NO_STORAGE', 0)
    if int(no_storage):
        env.Append(CXXFLAGS=" -DNO_STORAGE")
    return env


def _filter_out(nodes, basenames):
    """Drop File nodes whose basename is in `basenames` (for exclusive main()s)."""
    kept = []
    for n in nodes:
        if str(n).split('/')[-1] in basenames:
            continue
        kept.append(n)
    return kept


def getSources(target):
    en_emul = ARGUMENTS.get('NO_EMUL', 0)

    if (target == "build"):
        build_sources = (Glob(joinpath(base_path["build"], "*.cpp")) +
                         Glob(joinpath(base_path["build"], "tests/*.cpp")))
        if int(en_emul) != 1:
            build_sources += Glob(joinpath(base_path["tools_build"], "*/*.cpp"))
        # don't let pim_driver.cc become part of the gtest sim binary
        sources = _filter_out(build_sources + Glob(joinpath(base_path["build"], "*.cc")),
                              ["pim_driver.cc"])
    elif (target == "driver"):
        # driver uses everything except MainTest.cpp (gtest's main) and any
        # *TestCases.cpp (those reference TEST() macros that need gtest's main)
        nodes = (Glob(joinpath(base_path["build"], "*.cpp")) +
                 Glob(joinpath(base_path["build"], "tests/*.cpp")))
        if int(en_emul) != 1:
            nodes += Glob(joinpath(base_path["tools_build"], "*/*.cpp"))
        nodes = _filter_out(nodes, [
            "MainTest.cpp", "KernelTestCases.cpp", "MemTestCases.cpp",
            "PIMBenchTestCases.cpp",
        ])
        # add the driver source itself
        nodes.append(File(joinpath(base_path["build"], "pim_driver.cc")))
        sources = nodes
    elif (target == "lib"):
        lib_sources = Glob(joinpath(base_path["build"], "*.cpp"))
        lib_sources += Glob(joinpath(base_path["build"], "tests/PIMCmdGen.cpp"))
        lib_sources += Glob(joinpath(base_path["build"], "tests/PIMKernel.cpp"))
        lib_sources += Glob(joinpath(base_path["build"], "tests/KernelAddrGen.cpp"))
        if int(en_emul) != 1:
            lib_sources += Glob(joinpath(base_path["tools_build"], "emulator_api/*.cpp"))
        sources = lib_sources
    return sources


def build(target_name, base_path, build_flags):
    # setup the default build envronments
    env = Environment()
    # SCons runs the compiler with a minimal environment; pass the temporary
    # directory through so the build does not depend on free space in /tmp.
    for var in ("TMPDIR", "TMP", "TEMP"):
        if var in os.environ:
            env['ENV'][var] = os.environ[var]

    env.Append(CXXFLAGS=build_flags["CXXFLAGS"] + build_flags["gprof_option"])
    env.Append(LINKFLAGS=build_flags["LINKFLAGS"] + build_flags["gprof_option"])

    # add flags
    env = getFlags(env)

    env.VariantDir(base_path["build"], base_path["source"], duplicate=0)
    env.VariantDir(base_path["tools_build"], base_path["tools"], duplicate=0)
    build_sources = getSources("build")
    env.Program(target=target_name["binary"],
                source=build_sources,
                CPPPATH=[base_path["lib"], base_path["source"], base_path["tools"], gtest_inc],
                LIBPATH=['.', gtest_lib], LIBS=['gtest', 'pthread'])

    # pim_driver: same object soup, but with its own main() and no gtest driver
    driver_sources = getSources("driver")
    env.Program(target=target_name["driver"],
                source=driver_sources,
                CPPPATH=[base_path["lib"], base_path["source"], base_path["tools"], gtest_inc],
                # The standalone driver excludes every gtest translation unit;
                # requiring libgtest here made a source-complete runtime build
                # depend on an unrelated test-runner library.
                LIBPATH=['.'], LIBS=['pthread'])

    no_lib = ARGUMENTS.get('NO_LIBRARY', 0)
    if int(no_lib) == 0:
        lib_sources = getSources("lib")
        # print ("Creating a static library from objects")
        env.StaticLibrary(target=target_name["library"],
                          source=lib_sources,
                          CPPPATH=[base_path["lib"], base_path["source"], base_path["tools"], gtest_inc],
                          LIBPATH=['.', gtest_lib],
                          LIBS=['gtest', 'pthread'])
        # print ("Creating a shared library from objects")
        env.SharedLibrary(target=target_name["library"],
                          source=lib_sources,
                          CPPPATH=[base_path["lib"], base_path["source"], base_path["tools"], gtest_inc],
                          LIBPATH=['.', gtest_lib],
                          LIBS=['gtest', 'pthread'])


root_path = Dir('.').abspath

gtest_prefix = os.environ.get('GTEST_PREFIX', os.environ.get('CONDA_PREFIX', '/usr'))
gtest_inc = joinpath(gtest_prefix, 'include')
gtest_lib = joinpath(gtest_prefix, 'lib')

target_name = {
    "binary": 'sim',
    "driver": 'pim_driver',
    "library": './libdramsim/dramsim2',
}

base_path = {
    "source": joinpath(root_path, 'src'),
    "test": joinpath(root_path, 'src/tests'),
    "build": joinpath(root_path, 'bin'),
    "lib": joinpath(root_path, 'lib'),
    "tools_build": joinpath(root_path, 'bin/tools'),
    "tools": joinpath(root_path, 'tools'),
}

build_flags = {
    "gprof_option": '',
    "CXXFLAGS": '-g -O2 -std=c++14 -Wall -Wno-reorder -Wno-sign-compare',
    "LINKFLAGS": '-g -O2 -std=c++14 -Wall -Wno-reorder -Wno-sign-compare',
}

setNumJobs()
build(target_name, base_path, build_flags)
